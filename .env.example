# Copy this file to .env and adjust the values.
# .env is gitignored and must never be committed.

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=shopinv
POSTGRES_PASSWORD=shopinv
POSTGRES_DB=shopinv
POSTGRES_PORT=5432

# Backend (read by backend/internal/config)
DATABASE_URL=postgres://shopinv:shopinv@localhost:5432/shopinv?sslmode=disable
HTTP_PORT=8080
APP_ENV=development
GIN_MODE=debug
