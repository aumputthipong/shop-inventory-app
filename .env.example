# Copy this file to .env and adjust the values.
# .env is gitignored and must never be committed.

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=shopinv
POSTGRES_PASSWORD=shopinv
POSTGRES_DB=shopinv
POSTGRES_PORT=5433

# Backend (read by backend/internal/config)
DATABASE_URL=postgres://shopinv:shopinv@localhost:5433/shopinv?sslmode=disable
HTTP_PORT=8080
APP_ENV=development
GIN_MODE=debug
# STATIC_DIR serves a built frontend from the api; the Docker image sets it.
# COOKIE_SECURE defaults to true only in production. Set it to false when the
# shop is reached over plain http, for example on the shop's own network.
# STATIC_DIR=
# COOKIE_SECURE=

# Customer ordering from the shop's LINE Official Account; see docs/LINE-SETUP.md.
# LINE_MODE: off, dev or live. dev (the default in development) fakes LINE
# sign-in and logs messages instead of sending them, so /line works without a
# LINE account. Production refuses dev. live needs the three values below.
# LINE_MODE=dev
# LINE_LOGIN_CHANNEL_ID=
# LINE_LIFF_ID=
# LINE_CHANNEL_ACCESS_TOKEN=

# Online demo database (Neon), wiped and refilled by `make demo-reset`; see docs/DEPLOY.md.
# DEMO_DATABASE_URL=

# Disposable database for `make test-integration`; it is created and migrated for you
TEST_DATABASE_URL=postgres://shopinv:shopinv@localhost:5433/shopinv_test?sslmode=disable

# Accounts created by `make seed` on an empty database. Set SEED_SAMPLE_DATA=false
# to create only the accounts, for a real shop starting from zero.
SEED_OWNER_EMAIL=owner@shop.local
SEED_OWNER_PASSWORD=owner-pass-123
SEED_STAFF_EMAIL=staff@shop.local
SEED_STAFF_PASSWORD=staff-pass-123
SEED_SAMPLE_DATA=true

# `docker compose --profile app up --build` publishes the whole shop on this port
APP_PORT=8080
# DEMO_DATABASE_URL=